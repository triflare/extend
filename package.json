{
  "name": "@triflare/extend",
  "version": "0.2.0",
  "description": "Build, test, and ship extensions.",
  "author": "Triflare",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "url": "git+https://github.com/triflare/extend.git"
  },
  "bin": {
    "extend": "src/cli.js"
  },
  "files": [
    "src",
    "schema",
    "types",
    "product.yml"
  ],
  "exports": {
    "./types/*": "./types/*"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "turbowarp",
    "turbowarp-extension",
    "scratch",
    "scratch-extension",
    "compiler",
    "bundler",
    "extend",
    "build-tool"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctoc": "doctoc --notitle .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "doctoc": "^2.5.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.6"
  }
}
